{
  "name": "pocketbuddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.pocketbuddy.config.ts",
    "build": "vite build --config vite.pocketbuddy.config.ts",
    "mobile:sync": "npm run build && cap sync android",
    "preview": "vite preview --config vite.pocketbuddy.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "health:install-connectors": "node scripts/health/install-connectors.mjs",
    "health:verify-connectors": "node scripts/health/install-connectors.mjs --verify-only",
    "health:eval-qwen4b-skills": "vitest run scripts/health/qwen4b-skill-chain.live.test.ts --reporter=verbose"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "6.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
